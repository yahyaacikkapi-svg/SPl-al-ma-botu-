# ---------------------------------------------------------------
# ZORUNLU
# ---------------------------------------------------------------

# @BotFather'dan aldigin bot token
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# platform.openai.com/api-keys adresinden aldigin API anahtari
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook'u sadece Telegram'in tetikleyebilmesi icin gizli anahtar.
# Rastgele uzun bir metin uret:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=degistir-beni-rastgele-uzun-bir-metinle

# ---------------------------------------------------------------
# GUVENLIK (siddetle onerilir)
# ---------------------------------------------------------------

# Bota SADECE bu kullanicilar yazabilsin. Virgulle ayir.
# Kendi ID'ni ogrenmek icin Telegram'da @userinfobot'a yaz.
# Bos birakirsan botu bulan HERKES kullanabilir ve OpenAI faturasi sana gelir.
ALLOWED_USER_IDS=123456789

# ---------------------------------------------------------------
# HAFIZA (opsiyonel ama onerilir)
# Bos birakirsan bot gecici hafiza kullanir; sunucu uykuya
# gectiginde sohbet gecmisi silinir.
# ---------------------------------------------------------------

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------
# AYARLAR (hepsi opsiyonel)
#
# Asagidaki degerler zaten koddaki varsayilanlar - kisisel kullanimda
# maliyeti dusuk tutacak sekilde secildiler. Hicbirini .env'e yazmana
# gerek yok; sadece degistirmek istediklerini ekle.
# ---------------------------------------------------------------

# Sohbet modeli.
#   gpt-5.6-luna  -> en ucuz, gunluk sohbet icin fazlasiyla yeterli (varsayilan)
#   gpt-5.6-terra -> daha guclu, yaklasik 10 kat pahali
#   gpt-5.6-sol   -> en guclu, yaklasik 25 kat pahali
OPENAI_MODEL=gpt-5.6-luna

# Sesli mesaj cozumleme modeli.
#   gpt-4o-mini-transcribe -> yarim fiyat, kisa kayitlarda farki hissedilmez (varsayilan)
#   gpt-4o-transcribe      -> daha isabetli, iki kati fiyat
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Gorsel uretme modeli ve kalitesi.
# DIKKAT: /gorsel komutu bu botun acik ara en pahali islemi.
# Dusuk kalitede bir gorsel ~200 yazili mesaja, orta kalitede ~1600 mesaja bedel.
# Telegram'da dusuk kalite genelde yeterli gorunur; medium/high'a
# sadece gercekten gerekiyorsa gec.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low

# Modele verilecek kisilik / talimat
SYSTEM_PROMPT=Sen Telegram uzerinden konusan yardimci bir asistansin. Kullanici hangi dilde yazarsa o dilde, kisa ve net cevap ver.

# Hafizada tutulacak mesaj sayisi (kullanici basina).
# Her mesajda bu gecmisin tamami modele tekrar gonderiliyor, yani
# girdi maliyetinin neredeyse tamami buradan geliyor. 10 iyi bir denge;
# 20 yaparsan maliyet kabaca iki katina cikar.
MAX_HISTORY_MESSAGES=10
