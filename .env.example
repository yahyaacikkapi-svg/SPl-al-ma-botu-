# ---------------------------------------------------------------
# ZORUNLU
# ---------------------------------------------------------------

# @BotFather'dan aldigin bot token
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# platform.openai.com/api-keys adresinden aldigin API anahtari
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook'u sadece Telegram'in tetikleyebilmesi icin gizli anahtar.
# Rastgele uzun bir metin uret:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=degistir-beni-rastgele-uzun-bir-metinle

# ---------------------------------------------------------------
# GUVENLIK (siddetle onerilir)
# ---------------------------------------------------------------

# Bota SADECE bu kullanicilar yazabilsin. Virgulle ayir.
# Kendi ID'ni ogrenmek icin Telegram'da @userinfobot'a yaz.
# Bos birakirsan botu bulan HERKES kullanabilir ve OpenAI faturasi sana gelir.
ALLOWED_USER_IDS=123456789

# ---------------------------------------------------------------
# HAFIZA (opsiyonel ama onerilir)
# Bos birakirsan bot gecici hafiza kullanir; sunucu uykuya
# gectiginde sohbet gecmisi silinir.
# ---------------------------------------------------------------

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------
# AYARLAR (opsiyonel - hepsinin makul varsayilani var)
# ---------------------------------------------------------------

# Sohbet modeli. Alternatifler: gpt-5.6-sol (en guclu),
# gpt-5.6-terra / gpt-5.6-luna (daha ucuz/hizli)
OPENAI_MODEL=gpt-5.6

# Sesli mesaj cozumleme modeli
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Gorsel uretme modeli. Alternatif: gpt-image-1-mini (daha ucuz)
OPENAI_IMAGE_MODEL=gpt-image-2

# Modele verilecek kisilik / talimat
SYSTEM_PROMPT=Sen Telegram uzerinden konusan yardimci bir asistansin. Kullanici hangi dilde yazarsa o dilde, kisa ve net cevap ver.

# Hafizada tutulacak mesaj sayisi (kullanici basina)
MAX_HISTORY_MESSAGES=20
